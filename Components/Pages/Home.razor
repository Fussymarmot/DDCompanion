@* Home page: lists all saved characters. *@
@page "/"
@using DDCompanion.Models
@using DDCompanion.Services
@inject CharacterStorageService CharacterStorage
@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>D&D Companion</PageTitle>

@if (IsLoading)
{
    <div class="page-loading" aria-label="Загрузка">
        <div class="navigation-spinner"></div>
    </div>
}
else
{
<div class="home">
    <div class="home-heading">
        <div>
            <h1>Персонажи</h1>
            <p>Твои сохранённые персонажи</p>
        </div>
    </div>

    @if (Characters.Count == 0)
    {
        <div class="empty-state">
            <span>Пока нет персонажей</span>
            <span>Нажми «+» в шапке, чтобы создать персонажа.</span>
        </div>
    }
    else
    {
        <div class="character-grid">
            @foreach (var character in Characters)
            {
                <article class="character-card @(IsMenuOpen(character) ? "menu-open" : "")" @onclick="() => OpenCharacter(character)">
                    <div class="card-media">
                        @if (!string.IsNullOrWhiteSpace(character.ImageBase64))
                        {
                            <img src="@character.ImageBase64" alt="@character.Name" />
                        }
                        else
                        {
                            <div class="card-avatar">?</div>
                        }

                        <button class="card-menu-button" type="button" aria-label="Действия с персонажем" aria-haspopup="true"
                                @onclick="() => ToggleMenu(character)" @onclick:stopPropagation="true">
                            <span aria-hidden="true">⋮</span>
                        </button>
                    </div>

                    @if (IsMenuOpen(character))
                    {
                        <div class="card-menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
                        <div class="card-menu" role="menu" @onclick:stopPropagation="true">
                            <button class="card-menu-item" type="button" role="menuitem" @onclick="() => ShareCharacter(character)">Поделиться</button>
                            <button class="card-menu-item" type="button" role="menuitem" @onclick="() => EditCharacter(character)">Изменить</button>
                            <button class="card-menu-item danger-action" type="button" role="menuitem" @onclick="() => DeleteCharacter(character)">Удалить</button>
                        </div>
                    }

                    <div class="card-info">
                        <h2>@character.Name</h2>
                        <p>@character.Species · @character.Class</p>
                    </div>
                </article>
            }
        </div>
    }
</div>
}

@code {
    private List<Character> Characters = [];
    private bool IsLoading = true;
    
    private string? OpenMenuFileName;

    private static string GetFileName(Character character) =>
        character.StorageFileName ?? $"{character.Name}.ddc";

    private bool IsMenuOpen(Character character) =>
        OpenMenuFileName is not null && OpenMenuFileName == GetFileName(character);

    private void ToggleMenu(Character character)
    {
        var fileName = GetFileName(character);
        OpenMenuFileName = OpenMenuFileName == fileName ? null : fileName;
    }

    private void CloseMenu() => OpenMenuFileName = null;

    private void OpenCharacter(Character character)
    {
        CloseMenu();
        Navigation.NavigateTo($"/characters/{Uri.EscapeDataString(GetFileName(character))}");
    }

    private void EditCharacter(Character character)
    {
        CloseMenu();
        Navigation.NavigateTo($"/characters/edit/{Uri.EscapeDataString(GetFileName(character))}");
    }

    private async Task ShareCharacter(Character character)
    {
        CloseMenu();

        var path = CharacterStorage.GetCharacterPath(GetFileName(character));
        if (!File.Exists(path)) return;

        try
        {
            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Поделиться персонажем",
                File = new ShareFile(path)
            });
        }
        catch
        {
            // The user may have dismissed the native share sheet.
        }
    }

    private async Task DeleteCharacter(Character character)
    {
        CloseMenu();

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить персонажа «{character.Name}»? Файл персонажа будет удалён.");
        if (!confirmed) return;

        if (await CharacterStorage.DeleteAsync(GetFileName(character)))
            Characters.Remove(character);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Characters = (await CharacterStorage.LoadAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }

}
