@* Read-only character view with inline stat, health and protection editing. *@
@page "/characters/{FileName}"
@using DDCompanion.Models
@using DDCompanion.Services
@inject CharacterStorageService CharacterStorage

<PageTitle>@(IsLoading ? "Загрузка персонажа" : (Character?.Name ?? "Персонаж"))</PageTitle>

@if (IsLoading)
{
    <div class="character-loading" aria-label="Загрузка">
        <div class="navigation-spinner"></div>
    </div>
}
else if (Character is null)
{
    <div class="character-view empty-character"><h1>Персонаж не найден</h1></div>
}
else
{
    <div class="character-view">
        <section class="character-profile">
            @if (!string.IsNullOrWhiteSpace(Character.ImageBase64))
            {
                <img class="profile-avatar" src="@Character.ImageBase64" alt="@Character.Name" />
            }
            else
            {
                <div class="profile-avatar avatar-placeholder">?</div>
            }
            <div><h1>@Character.Name</h1><p>@Character.Species · @Character.Class</p></div>
        </section>

        <section class="view-section">
            <h2>Основные сведения</h2>
            <div class="character-details-grid">
                <div class="character-detail">
                    <span class="detail-label">Мировоззрение</span>
                    <strong class="detail-value">@(string.IsNullOrWhiteSpace(Character.Worldview) ? "—" : Character.Worldview)</strong>
                </div>
                <div class="character-detail">
                    <span class="detail-label">Телосложение</span>
                    <strong class="detail-value">@(string.IsNullOrWhiteSpace(Character.BodyType) ? "—" : Character.BodyType)</strong>
                </div>
                <div class="character-detail character-detail-wide">
                    <span class="detail-label">Предыстория</span>
                    <p class="detail-text">@(string.IsNullOrWhiteSpace(Character.Backstory) ? "—" : Character.Backstory)</p>
                </div>
            </div>
        </section>
        
        <section class="view-section">
            <h2>Здоровье</h2>
            <div class="character-detail health-detail">
                <span class="detail-label">Текущее здоровье</span>
                <div class="value-row">
                    <button class="value-button danger" type="button" @onclick="() => ChangeHealth(-1)" aria-label="Уменьшить здоровье">−</button>
                    <strong class="detail-value health-value">@Character.Combat.CurrentHealth / @Character.Combat.MaxHealth</strong>
                    <button class="value-button" type="button" @onclick="() => ChangeHealth(1)" aria-label="Увеличить здоровье">+</button>
                </div>
            </div>
        </section>

        <section class="view-section">
            <h2>Боевые параметры</h2>
            <div class="combat-details-grid">
                <div class="character-detail">
                    <span class="detail-label">Класс брони</span>
                    <strong class="detail-value">@Character.Combat.ArmorClass</strong>
                </div>
                <div class="character-detail protection-detail">
                    <span class="detail-label">Защита</span>
                    <div class="value-row">
                        <button class="value-button danger" type="button" @onclick="() => ChangeProtection(-1)">−</button>
                        <strong class="detail-value">@Character.Combat.Protection</strong>
                        <button class="value-button" type="button" @onclick="() => ChangeProtection(1)">+</button>
                    </div>
                </div>
                @if (!HasEquipmentPhotos)
                {
                    <div class="character-detail">
                        <span class="detail-label">Оружие</span>
                        <strong class="detail-value">@(string.IsNullOrWhiteSpace(Character.Combat.Weapon) ? "—" : Character.Combat.Weapon)</strong>
                    </div>
                    <div class="character-detail">
                        <span class="detail-label">Броня</span>
                        <strong class="detail-value">@(string.IsNullOrWhiteSpace(Character.Combat.Armor) ? "—" : Character.Combat.Armor)</strong>
                    </div>
                }
            </div>

            @if (HasEquipmentPhotos)
            {
                <div class="equipment-grid">
                    @EquipmentCard("Оружие", Character.Combat.Weapon, Character.Combat.WeaponImageBase64, "⚔")
                    @EquipmentCard("Броня", Character.Combat.Armor, Character.Combat.ArmorImageBase64, "🛡")
                </div>
            }
        </section>

        <section class="view-section">
            <h2>Характеристики</h2>
            <div class="stats-grid">
                @Stat("Сила", Character.Stats.Strength, Character.Stats.StrengthModifier, v => Character.Stats.Strength = v, () => Character.Stats.StrengthModifier = CalculateModifier(Character.Stats.Strength))
                @Stat("Ловкость", Character.Stats.Dexterity, Character.Stats.DexterityModifier, v => Character.Stats.Dexterity = v, () => Character.Stats.DexterityModifier = CalculateModifier(Character.Stats.Dexterity))
                @Stat("Телосложение", Character.Stats.Constitution, Character.Stats.ConstitutionModifier, v => Character.Stats.Constitution = v, () => Character.Stats.ConstitutionModifier = CalculateModifier(Character.Stats.Constitution))
                @Stat("Интеллект", Character.Stats.Intelligence, Character.Stats.IntelligenceModifier, v => Character.Stats.Intelligence = v, () => Character.Stats.IntelligenceModifier = CalculateModifier(Character.Stats.Intelligence))
                @Stat("Мудрость", Character.Stats.Wisdom, Character.Stats.WisdomModifier, v => Character.Stats.Wisdom = v, () => Character.Stats.WisdomModifier = CalculateModifier(Character.Stats.Wisdom))
                @Stat("Харизма", Character.Stats.Charisma, Character.Stats.CharismaModifier, v => Character.Stats.Charisma = v, () => Character.Stats.CharismaModifier = CalculateModifier(Character.Stats.Charisma))
            </div>
        </section>

        <CollapsibleSection Title="Навыки" SectionClass="view-section" AddLabel="＋ Добавить" Count="Character.Skills.Count" OnAdd="AddSkill">
            @foreach (var skill in Character.Skills)
            {
                <div class="skill-card" @key="skill">
                    <button class="remove-button card-remove" type="button" aria-label="Удалить навык" @onclick="() => RemoveSkill(skill)">×</button>
                    <InputText @bind-Value="skill.Name" @bind-Value:after="Save" class="input" placeholder="Название навыка" />
                    <InputTextArea @bind-Value="skill.Description" @bind-Value:after="Save" class="input description-input" placeholder="Описание" rows="3" />
                </div>
            }
        </CollapsibleSection>

        <CollapsibleSection Title="Инвентарь" SectionClass="view-section" AddLabel="＋ Добавить" Count="Character.Inventory.Count" OnAdd="AddItem">
            @foreach (var item in Character.Inventory)
            {
                <div class="item-card" @key="item">
                    <button class="remove-button card-remove" type="button" aria-label="Удалить предмет" @onclick="() => RemoveItem(item)">×</button>
                    <div class="item-card-fields">
                        <InputText @bind-Value="item.Name" @bind-Value:after="Save" class="input" placeholder="Название предмета" />
                        <div class="quantity-field"><span class="quantity-label">Количество</span><InputNumber @bind-Value="item.Quantity" @bind-Value:after="Save" class="input quantity-input" /></div>
                        <InputTextArea @bind-Value="item.Description" @bind-Value:after="Save" class="input description-input" placeholder="Описание" rows="3" />
                    </div>
                </div>
            }
        </CollapsibleSection>
    </div>
}

@code {
    [Parameter] public string FileName { get; set; } = string.Empty;
    private Character? Character;
    private string? CharacterPath;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        Character = null;

        CharacterPath = CharacterStorage.GetCharacterPath(Uri.UnescapeDataString(FileName));

        try
        {
            Character = await CharacterStorage.LoadAsync(CharacterPath);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private RenderFragment Stat(string name, int value, int modifier, Action<int> set, Action recalculateModifier) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "stat-control");
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "stat-label");
        builder.OpenElement(seq++, "span"); builder.AddContent(seq++, name); builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "value-control stat-value-control");
        builder.OpenElement(seq++, "button"); builder.AddAttribute(seq++, "class", "stat-button"); builder.AddAttribute(seq++, "type", "button"); builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await ChangeStat(set, recalculateModifier, value - 1))); builder.AddContent(seq++, "−"); builder.CloseElement();
        builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, value); builder.CloseElement();
        builder.OpenElement(seq++, "button"); builder.AddAttribute(seq++, "class", "stat-button"); builder.AddAttribute(seq++, "type", "button"); builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await ChangeStat(set, recalculateModifier, value + 1))); builder.AddContent(seq++, "+"); builder.CloseElement();
        builder.OpenElement(seq++, "span"); builder.AddAttribute(seq++, "class", "stat-modifier"); builder.AddContent(seq++, FormatModifier(modifier)); builder.CloseElement();
        builder.CloseElement(); builder.CloseElement();
    };

    private bool HasEquipmentPhotos =>
        Character is not null &&
        (!string.IsNullOrWhiteSpace(Character.Combat.WeaponImageBase64) ||
         !string.IsNullOrWhiteSpace(Character.Combat.ArmorImageBase64));

    // Weapon / armor card: photo on top (or a quiet placeholder when only the other item has a photo).
    private static RenderFragment EquipmentCard(string label, string name, string image, string glyph) => builder =>
    {
        var hasImage = !string.IsNullOrWhiteSpace(image);
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "equipment-card");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", hasImage ? "equipment-media" : "equipment-media equipment-media-empty");
        if (hasImage)
        {
            builder.OpenElement(seq++, "img");
            builder.AddAttribute(seq++, "src", image);
            builder.AddAttribute(seq++, "alt", string.IsNullOrWhiteSpace(name) ? label : name);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, glyph);
            builder.CloseElement();
        }
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "equipment-caption");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "detail-label");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "strong");
        builder.AddAttribute(seq++, "class", "detail-value");
        builder.AddContent(seq++, string.IsNullOrWhiteSpace(name) ? "—" : name);
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement();
    };

    private static string FormatModifier(int modifier) => modifier > 0 ? "+" + modifier : modifier == 0 ? "+0" : modifier.ToString();

    private static int CalculateModifier(int value) => (value - 10) / 2;

    private async Task ChangeStat(Action<int> set, Action recalculateModifier, int newValue)
    {
        set(newValue);
        recalculateModifier();
        await Save();
    }

    private async Task ChangeHealth(int delta)
    {
        if (Character is null) return;
        if (delta > 0 && Character.Combat.CurrentHealth >= Character.Combat.MaxHealth)
        { Character.Combat.MaxHealth++; Character.Combat.CurrentHealth++; }
        else Character.Combat.CurrentHealth = Math.Clamp(Character.Combat.CurrentHealth + delta, 0, Math.Max(0, Character.Combat.MaxHealth));
        await Save();
    }
    private async Task ChangeProtection(int delta) { if (Character is null) return; Character.Combat.Protection = Math.Max(0, Character.Combat.Protection + delta); await Save(); }
    // New entries go to the top of the list so they appear right under the "Add" button.
    // Every change is written to the file immediately (text fields save when they lose focus).
    private async Task AddSkill() { Character!.Skills.Insert(0, new CharacterSkill()); await Save(); }
    private async Task RemoveSkill(CharacterSkill skill) { Character!.Skills.Remove(skill); await Save(); }
    private async Task AddItem() { Character!.Inventory.Insert(0, new CharacterItem()); await Save(); }
    private async Task RemoveItem(CharacterItem item) { Character!.Inventory.Remove(item); await Save(); }
    private async Task Save() { if (Character is not null && CharacterPath is not null) await CharacterStorage.SaveToPathAsync(Character, CharacterPath); }
}
