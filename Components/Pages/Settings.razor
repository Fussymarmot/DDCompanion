@* Settings page: where character files live and how the .ddc format works. *@
@page "/settings"
@using DDCompanion.Services
@using DDCompanion.Models
@inject CharacterStorageService CharacterStorage
@inject SettingsTransferService SettingsTransfer
@implements IDisposable

<PageTitle>Настройки</PageTitle>

<div class="settings-page">

    <section class="settings-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-options">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="currentColor" d="M320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64zM256 142.9C238.5 185.4 227.4 234.6 224.7 288L128.8 288C141.5 221.7 190.5 167.7 256 142.9zM128.8 352L224.7 352C227.4 405.4 238.5 454.6 256 497.1C190.5 472.3 141.5 418.3 128.8 352zM288.8 497.7C269.4 456.4 256.8 406.4 253.7 352L386.3 352C383.2 406.4 370.6 456.4 351.2 497.7C341.6 518.1 329.9 532.4 320 539.8C310.1 532.4 298.4 518.1 288.8 497.7zM386.3 288L253.7 288C256.8 233.6 269.4 183.6 288.8 142.3C298.4 121.9 310.1 107.6 320 100.2C329.9 107.6 341.6 121.9 351.2 142.3C370.6 183.6 383.2 233.6 386.3 288zM384 497.1C401.5 454.6 412.6 405.4 415.3 352L511.2 352C498.5 418.3 449.5 472.3 384 497.1zM415.3 288C412.6 234.6 401.5 185.4 384 142.9C449.5 167.7 498.5 221.7 511.2 288L415.3 288z"/></svg>
            </div>
            <div>
                <h2>Подсказки рас</h2>
                <p class="settings-card-subtitle">Список вариантов для поля «Раса»</p>
            </div>
        </div>
        <p class="settings-card-text options-description">Настройте список рас под свою кампанию. Поле остаётся свободным — в него по-прежнему можно вписать любой текст.</p>
        <div class="option-add-row">
            <input class="option-input" @bind="NewRace" @bind:event="oninput" @onkeydown="HandleRaceKey" placeholder="Новая раса" />
            <button class="option-add-button" type="button" @onclick="AddRace" disabled="@string.IsNullOrWhiteSpace(NewRace)">Добавить</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(RaceAddMessage))
        {
            <div class="option-add-notice">@RaceAddMessage</div>
        }
        <button class="option-list-toggle" type="button" @onclick="ToggleRaces" aria-expanded="@ShowRaces">
            <span>@(ShowRaces ? "Скрыть список" : $"Показать список ({Races.Count})")</span>
            <svg class="option-list-toggle-icon @(ShowRaces ? "is-open" : "")" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" aria-hidden="true">
                <path fill="currentColor" d="M297.4 471.1L105.4 279.1C92.9 266.6 92.9 246.3 105.4 233.8C117.9 221.3 138.2 221.3 150.7 233.8L320 403.2L489.4 233.9C501.9 221.4 522.2 221.4 534.7 233.9C547.2 246.4 547.2 266.7 534.7 279.2L342.7 471.2C330.2 483.6 309.9 483.6 297.4 471.1z"/>
            </svg>
        </button>
        @if (ShowRaces)
        {
            <div class="option-chips">
                @foreach (var item in Races)
                {
                    <button class="option-chip @(DeletingRace == item ? "is-delete-mode" : "")" type="button"
                            title="@(DeletingRace == item ? $"Нажмите, чтобы удалить {item}" : $"Удерживайте для удаления {item}")"
                            @onpointerdown="() => BeginRacePress(item)"
                            @onpointerup="() => EndRacePress(item)"
                            @onpointercancel="CancelRacePress"
                            @onpointerleave="CancelRacePress">
                        <span>@(DeletingRace == item ? "Удалить" : item)</span>
                    </button>
                }
            </div>
        }
    </section>
    
    <section class="settings-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-options">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="currentColor" d="M160 128C160 110.3 174.3 96 192 96L448 96C465.7 96 480 110.3 480 128C480 145.7 465.7 160 448 160L192 160C174.3 160 160 145.7 160 128zM96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320zM192 480C192 462.3 206.3 448 224 448L416 448C433.7 448 448 462.3 448 480C448 497.7 433.7 512 416 512L224 512C206.3 512 192 497.7 192 480z"/></svg>
            </div>
            <div>
                <h2>Подсказки классов</h2>
                <p class="settings-card-subtitle">Список вариантов для поля «Класс»</p>
            </div>
        </div>
        <p class="settings-card-text options-description">Добавляйте свои классы или удаляйте ненужные. Изменения сразу применяются в создании и редактировании персонажа.</p>
        <div class="option-add-row">
            <input class="option-input" @bind="NewClass" @bind:event="oninput" @onkeydown="HandleClassKey" placeholder="Новый класс" />
            <button class="option-add-button" type="button" @onclick="AddClass" disabled="@string.IsNullOrWhiteSpace(NewClass)">Добавить</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(ClassAddMessage))
        {
            <div class="option-add-notice">@ClassAddMessage</div>
        }
        <button class="option-list-toggle" type="button" @onclick="ToggleClasses" aria-expanded="@ShowClasses">
            <span>@(ShowClasses ? "Скрыть список" : $"Показать список ({Classes.Count})")</span>
            <svg class="option-list-toggle-icon @(ShowClasses ? "is-open" : "")" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" aria-hidden="true">
                <path fill="currentColor" d="M297.4 471.1L105.4 279.1C92.9 266.6 92.9 246.3 105.4 233.8C117.9 221.3 138.2 221.3 150.7 233.8L320 403.2L489.4 233.9C501.9 221.4 522.2 221.4 534.7 233.9C547.2 246.4 547.2 266.7 534.7 279.2L342.7 471.2C330.2 483.6 309.9 483.6 297.4 471.1z"/>
            </svg>
        </button>
        @if (ShowClasses)
        {
            <div class="option-chips">
                @foreach (var item in Classes)
                {
                    <button class="option-chip @(DeletingClass == item ? "is-delete-mode" : "")" type="button"
                            title="@(DeletingClass == item ? $"Нажмите, чтобы удалить {item}" : $"Удерживайте для удаления {item}")"
                            @onpointerdown="() => BeginClassPress(item)"
                            @onpointerup="() => EndClassPress(item)"
                            @onpointercancel="CancelClassPress"
                            @onpointerleave="CancelClassPress">
                        <span>@(DeletingClass == item ? "Удалить" : item)</span>
                    </button>
                }
            </div>
        }
    </section>

    <section class="settings-card settings-transfer-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-transfer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="currentColor" d="M320 64C337.7 64 352 78.3 352 96L352 274.7L401.4 225.3C413.9 212.8 434.2 212.8 446.7 225.3C459.2 237.8 459.2 258.1 446.7 270.6L342.7 374.6C330.2 387.1 309.9 387.1 297.4 374.6L193.4 270.6C180.9 258.1 180.9 237.8 193.4 225.3C205.9 212.8 226.2 212.8 238.7 225.3L288 274.7L288 96C288 78.3 302.3 64 320 64zM128 352C145.7 352 160 366.3 160 384L160 480C160 497.7 174.3 512 192 512L448 512C465.7 512 480 497.7 480 480L480 384C480 366.3 494.3 352 512 352C529.7 352 544 366.3 544 384L544 480C544 533 501 576 448 576L192 576C139 576 96 533 96 480L96 384C96 366.3 110.3 352 128 352z"/></svg>
            </div>
            <div>
                <h2>Экспорт и импорт настроек</h2>
                <p class="settings-card-subtitle">Перенос настроек на другое устройство</p>
            </div>
        </div>

        <p class="settings-card-text transfer-description">
            Сохраните списки классов и рас в файл <span class="ext-badge">.ddcs</span>, отправьте его другому человеку или импортируйте полученный файл.
        </p>

        <div class="settings-transfer-actions">
            <button class="settings-transfer-button transfer-primary" type="button" @onclick="ExportSettings">
                <span class="transfer-button-icon">↥</span>
                <span><strong>Экспортировать</strong><small>Сохранить файл настроек</small></span>
            </button>
            <button class="settings-transfer-button" type="button" @onclick="ImportSettings">
                <span class="transfer-button-icon">↧</span>
                <span><strong>Импортировать</strong><small>Загрузить настройки из файла</small></span>
            </button>
            <button class="settings-transfer-button" type="button" @onclick="ShareSettings">
                <span class="transfer-button-icon">↗</span>
                <span><strong>Поделиться</strong><small>Отправить настройки другому человеку</small></span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(SettingsMessage))
        {
            <div class="settings-transfer-message @(SettingsError ? "is-error" : "is-success")">@SettingsMessage</div>
        }
    </section>

    <section class="settings-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-folder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="none">
                    <path fill="currentColor" d="M64 149.3C64 114 92.7 85.3 128 85.3L241.5 85.3C258.5 85.3 274.8 92 286.8 104L308.1 125.3C320.1 137.3 336.4 144 353.4 144L512 144C547.3 144 576 172.7 576 208L576 448C576 483.3 547.3 512 512 512L128 512C92.7 512 64 483.3 64 448L64 149.3z"/>
                </svg>
            </div>
            <div>
                <h2>Хранение файлов</h2>
                <p class="settings-card-subtitle">Куда сохраняются персонажи</p>
            </div>
        </div>

        <p class="settings-card-text">
            Все персонажи хранятся <strong>локально, на этом устройстве</strong> — в приватной папке приложения.
            Каждый персонаж — это отдельный файл с расширением <span class="ext-badge">.ddc</span>.
        </p>

        <div class="settings-path-block">
            <span class="settings-path-label">Путь к папке персонажей</span>
            <code class="settings-path">@CharactersDirectory</code>
        </div>

        <ul class="settings-fact-list">
            <li><span class="fact-dot"></span><span>Файлы <strong>не синхронизируются</strong> в облако — они есть только на этом устройстве.</span></li>
            <li><span class="fact-dot"></span><span>Удаление персонажа в приложении безвозвратно удаляет его файл <span class="ext-badge ext-badge-sm">.ddc</span> из этой папки.</span></li>
            <li><span class="fact-dot"></span><span>Чтобы перенести персонажа на другое устройство, используйте кнопку <strong>«Поделиться»</strong> на странице персонажа.</span></li>
        </ul>
    </section>

    <section class="settings-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-file">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="none">
                    <path fill="currentColor" d="M128 64C92.7 64 64 92.7 64 128L64 512C64 547.3 92.7 576 128 576L448 576C483.3 576 512 547.3 512 512L512 245.3L352 245.3C325.5 245.3 304 223.8 304 197.3L304 64L128 64zM352 64L352 197.3C352 197.5 352.1 197.3 352.4 197.3L512 197.3L352 64z"/>
                </svg>
            </div>
            <div>
                <h2>Формат .ddc</h2>
                <p class="settings-card-subtitle">Как устроен файл персонажа</p>
            </div>
        </div>

        <p class="settings-card-text">
            Файл <span class="ext-badge">.ddc</span> — это обычный текстовый файл в формате <span class="pill pill-json">JSON</span>.
            Его можно открыть в любом текстовом редакторе, отредактировать вручную или сохранить в системе контроля версий.
        </p>

        <div class="format-structure">
            <div class="format-field">
                <div class="format-field-head">
                    <span class="field-name">Format</span>
                    <span class="field-type type-string">string</span>
                </div>
                <p>Метка формата, всегда равна <span class="value-badge">"DDC"</span> — по ней приложение отличает файлы персонажей от прочих JSON-файлов.</p>
            </div>
            <div class="format-field">
                <div class="format-field-head">
                    <span class="field-name">Version</span>
                    <span class="field-type type-number">number</span>
                </div>
                <p>Версия схемы данных. Нужна, чтобы аккуратно обновлять старых персонажей при загрузке, не трогая новые файлы.</p>
            </div>
            <div class="format-field">
                <div class="format-field-head">
                    <span class="field-name">Character</span>
                    <span class="field-type type-object">object</span>
                </div>
                <p>Сам персонаж целиком: характеристики, навыки, снаряжение, боевые параметры и всё остальное.</p>
            </div>
        </div>

        <p class="settings-hint">
            Формат <strong>открытый</strong> и <strong>человекочитаемый</strong> — никакой магии и бинарных данных, только понятный JSON.
        </p>
    </section>

    <section class="settings-card">
        <div class="settings-card-head">
            <div class="settings-card-icon icon-contact">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="none">
                    <path fill="currentColor" d="M96 160C60.7 160 32 188.7 32 224L32 416C32 451.3 60.7 480 96 480L544 480C579.3 480 608 451.3 608 416L608 224C608 188.7 579.3 160 544 160L96 160zM96 224L544 224C547.3 224 550 226.5 550 229.6L550 236L331.8 379.6C324.4 384.4 315 384.4 307.6 379.6L90 236L90 229.6C90 226.5 92.7 224 96 224zM90 274L280.7 398.2C299 410.1 322.4 410.2 340.8 398.4L344 396.3L550 274L550 410.4C550 413.5 547.3 416 544 416L96 416C92.7 416 90 413.5 90 410.4L90 274z"/>
                </svg>
            </div>
            <div>
                <h2>Контакты</h2>
                <p class="settings-card-subtitle">Автор приложения и обратная связь</p>
            </div>
        </div>

        <div class="contact-links">
            <button class="contact-link" type="button" @onclick='() => OpenLink("https://github.com/fussymarmot")'>
                <span class="contact-link-icon contact-link-icon-github">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="rgb(255, 255, 255)" d="M280.5 426.5C214.5 418.5 168 371 168 309.5C168 284.5 177 257.5 192 239.5C185.5 223 186.5 188 194 173.5C214 171 241 181.5 257 196C276 190 296 187 320.5 187C345 187 365 190 383 195.5C398.5 181.5 426 171 446 173.5C453 187 454 222 447.5 239C463.5 258 472 283.5 472 309.5C472 371 425.5 417.5 358.5 426C375.5 437 387 461 387 488.5L387 540.5C387 555.5 399.5 564 414.5 558C505 523.5 576 433 576 321C576 179.5 461 64 319.5 64C178 64 64 179.5 64 321C64 432 134.5 524 229.5 558.5C243 563.5 256 554.5 256 541L256 501C249 504 240 506 232 506C199 506 179.5 488 165.5 454.5C160 441 154 433 142.5 431.5C136.5 431 134.5 428.5 134.5 425.5C134.5 419.5 144.5 415 154.5 415C169 415 181.5 424 194.5 442.5C204.5 457 215 463.5 227.5 463.5C240 463.5 248 459 259.5 447.5C268 439 274.5 431.5 280.5 426.5z"/></svg>
                </span>
                <span class="contact-link-body">
                    <span class="contact-link-title">GitHub</span>
                    <span class="contact-link-value">github.com/fussymarmot</span>
                </span>
                <span class="contact-link-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path fill="currentColor" d="M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z"/></svg>
                </span>
            </button>

            <button class="contact-link" type="button" @onclick='() => OpenLink("https://t.me/pussymamont")'>
                <span class="contact-link-icon contact-link-icon-telegram">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="rgb(255, 255, 255)" d="M320 72C183 72 72 183 72 320C72 457 183 568 320 568C457 568 568 457 568 320C568 183 457 72 320 72zM435 240.7C431.3 279.9 415.1 375.1 406.9 419C403.4 437.6 396.6 443.8 390 444.4C375.6 445.7 364.7 434.9 350.7 425.7C328.9 411.4 316.5 402.5 295.4 388.5C270.9 372.4 286.8 363.5 300.7 349C304.4 345.2 367.8 287.5 369 282.3C369.2 281.6 369.3 279.2 367.8 277.9C366.3 276.6 364.2 277.1 362.7 277.4C360.5 277.9 325.6 300.9 258.1 346.5C248.2 353.3 239.2 356.6 231.2 356.4C222.3 356.2 205.3 351.4 192.6 347.3C177.1 342.3 164.7 339.6 165.8 331C166.4 326.5 172.5 322 184.2 317.3C256.5 285.8 304.7 265 328.8 255C397.7 226.4 412 221.4 421.3 221.2C423.4 221.2 427.9 221.7 430.9 224.1C432.9 225.8 434.1 228.2 434.4 230.8C434.9 234 435 237.3 434.8 240.6z"/></svg>
                </span>
                <span class="contact-link-body">
                    <span class="contact-link-title">Telegram</span>
                    <span class="contact-link-value">t.me/pussymamont</span>
                </span>
                <span class="contact-link-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path fill="currentColor" d="M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z"/></svg>
                </span>
            </button>
        </div>
    </section>

</div>

@code {
    private string NewClass { get; set; } = string.Empty;
    private string NewRace { get; set; } = string.Empty;
    private string? ClassAddMessage { get; set; }
    private string? RaceAddMessage { get; set; }
    private string? SettingsMessage { get; set; }
    private bool SettingsError { get; set; }
    private bool ShowRaces { get; set; }
    private bool ShowClasses { get; set; }
    private string? DeletingRace { get; set; }
    private string? DeletingClass { get; set; }
    private CancellationTokenSource? RacePressCts { get; set; }
    private CancellationTokenSource? ClassPressCts { get; set; }
    private bool RaceLongPressActivated { get; set; }
    private bool ClassLongPressActivated { get; set; }
    private IReadOnlyList<string> Classes => CharacterOptions.Classes;
    private IReadOnlyList<string> Races => CharacterOptions.Races;
    private string CharactersDirectory => CharacterStorage.GetCharactersDirectory();

    private void AddClass()
    {
        if (string.IsNullOrWhiteSpace(NewClass)) return;

        if (CharacterOptions.AddClass(NewClass))
        {
            NewClass = string.Empty;
            ClassAddMessage = null;
        }
        else
        {
            ClassAddMessage = "Такой класс уже есть в подсказках.";
        }
    }

    private void AddRace()
    {
        if (string.IsNullOrWhiteSpace(NewRace)) return;

        if (CharacterOptions.AddRace(NewRace))
        {
            NewRace = string.Empty;
            RaceAddMessage = null;
        }
        else
        {
            RaceAddMessage = "Такая раса уже есть в подсказках.";
        }
    }

    private void ToggleRaces()
    {
        ShowRaces = !ShowRaces;
        DeletingRace = null;
    }

    private void ToggleClasses()
    {
        ShowClasses = !ShowClasses;
        DeletingClass = null;
    }

    private void BeginRacePress(string value)
    {
        CancelRacePress();
        if (DeletingRace == value)
            return;

        RacePressCts = new CancellationTokenSource();
        _ = ActivateRaceDeleteModeAsync(value, RacePressCts.Token);
    }

    private async Task ActivateRaceDeleteModeAsync(string value, CancellationToken token)
    {
        try
        {
            await Task.Delay(550, token);
            if (!token.IsCancellationRequested)
            {
                DeletingClass = null;
                DeletingRace = value;
                RaceLongPressActivated = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void EndRacePress(string value)
    {
        var wasDeleteMode = DeletingRace == value;
        var wasLongPress = RaceLongPressActivated;
        CancelRacePress();
        if (wasDeleteMode && !wasLongPress)
        {
            CharacterOptions.RemoveRace(value);
            DeletingRace = null;
        }
        RaceLongPressActivated = false;
    }

    private void CancelRacePress()
    {
        RacePressCts?.Cancel();
        RacePressCts?.Dispose();
        RacePressCts = null;
    }

    private void BeginClassPress(string value)
    {
        CancelClassPress();
        if (DeletingClass == value)
            return;

        ClassPressCts = new CancellationTokenSource();
        _ = ActivateClassDeleteModeAsync(value, ClassPressCts.Token);
    }

    private async Task ActivateClassDeleteModeAsync(string value, CancellationToken token)
    {
        try
        {
            await Task.Delay(550, token);
            if (!token.IsCancellationRequested)
            {
                DeletingRace = null;
                DeletingClass = value;
                ClassLongPressActivated = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void EndClassPress(string value)
    {
        var wasDeleteMode = DeletingClass == value;
        var wasLongPress = ClassLongPressActivated;
        CancelClassPress();
        if (wasDeleteMode && !wasLongPress)
        {
            CharacterOptions.RemoveClass(value);
            DeletingClass = null;
        }
        ClassLongPressActivated = false;
    }

    private void CancelClassPress()
    {
        ClassPressCts?.Cancel();
        ClassPressCts?.Dispose();
        ClassPressCts = null;
    }

    private void HandleClassKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddClass();
    }

    private void HandleRaceKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddRace();
    }


    private async Task ExportSettings()
    {
        SettingsMessage = null;
        SettingsError = false;
        try
        {
            var path = await SettingsTransfer.ExportAsync();
            if (!string.IsNullOrWhiteSpace(path))
                SettingsMessage = "Настройки сохранены в выбранное место.";
        }
        catch (UnauthorizedAccessException ex)
        {
            SettingsError = true;
            SettingsMessage = ex.Message;
        }
        catch (Exception ex)
        {
            SettingsError = true;
            SettingsMessage = $"Не удалось экспортировать настройки: {ex.Message}";
        }
    }

    private async Task ShareSettings()
    {
        SettingsMessage = null;
        SettingsError = false;
        try
        {
            await SettingsTransfer.ShareAsync("Поделиться настройками D&D Companion");
        }
        catch
        {
            // The user may have dismissed the native share sheet.
        }
    }

    private async Task ImportSettings()
    {
        SettingsMessage = null;
        SettingsError = false;

        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Выберите файл настроек D&D Companion",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    [DevicePlatform.Android] = new[] { "application/json", "application/octet-stream", "*/*" },
                    [DevicePlatform.WinUI] = new[] { ".ddcs", ".json" },
                    [DevicePlatform.MacCatalyst] = new[] { "ddcs", "json" },
                    [DevicePlatform.iOS] = new[] { "ddcs", "json" }
                })
            });

            if (file is null) return;

            await using var stream = await file.OpenReadAsync();
            await SettingsTransfer.ImportAsync(stream);
            SettingsMessage = "Настройки импортированы. Списки классов и рас обновлены.";
        }
        catch (Exception ex)
        {
            SettingsError = true;
            SettingsMessage = $"Не удалось импортировать настройки: {ex.Message}";
        }
    }

    public void Dispose()
    {
        CancelRacePress();
        CancelClassPress();
    }

    private async Task OpenLink(string url)
    {
        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch
        {
            // The device may not have a way to handle the link; fail silently.
        }
    }
}
