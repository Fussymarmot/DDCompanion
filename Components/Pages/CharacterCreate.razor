@* Character creation form. *@
@page "/characters/create"
@using DDCompanion.Models
@using DDCompanion.Services
@inject CharacterStorageService CharacterStorage
@inject NavigationManager Navigation

<PageTitle>Создание персонажа</PageTitle>

<div class="character-create">
    @if (!string.IsNullOrWhiteSpace(SaveError))
    {
        <div class="avatar-error">@SaveError</div>
    }

    <EditForm id="character-form" Model="@Character" OnValidSubmit="CreateCharacter">
        <DataAnnotationsValidator />

        <section class="character-hero">
            <div class="avatar-column">
                <button class="avatar-picker" type="button" @onclick="PickAvatar">
                    @if (!string.IsNullOrWhiteSpace(Character.ImageBase64))
                    { <img src="@Character.ImageBase64" alt="Аватар персонажа" /> }
                    else { <span class="avatar-placeholder">+</span> }
                </button>
                <span class="avatar-hint">Аватар персонажа</span>
                @if (!string.IsNullOrWhiteSpace(AvatarError)) { <span class="avatar-error">@AvatarError</span> }
            </div>
            <div class="identity">
                <label>Имя персонажа<InputText @bind-Value="Character.Name" class="input" placeholder="Например, Элира" /></label>
                <div class="two-columns">
                    <label>Раса<SuggestInput @bind-Value="Character.Species" Suggestions="CharacterOptions.Races" Placeholder="Человек" /></label>
                    <label>Класс<SuggestInput @bind-Value="Character.Class" Suggestions="CharacterOptions.Classes" Placeholder="Воин" /></label>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2>Основные сведения</h2>
            <div class="two-columns">
                <label>Мировоззрение<InputText @bind-Value="Character.Worldview" class="input" placeholder="Нейтрально-добрый" /></label>
                <label>Телосложение<InputText @bind-Value="Character.BodyType" class="input" placeholder="Среднее" /></label>
            </div>
            <label>Предыстория<InputTextArea @bind-Value="Character.Backstory" class="input textarea" placeholder="Расскажи немного о персонаже..." /></label>
        </section>

        <section class="form-section">
            <h2>Характеристики</h2>
            <div class="stats-grid">
                <label class="stat"><span>Сила</span><InputNumber @bind-Value="Character.Stats.Strength" @bind-Value:after="RecalculateModifiers" class="input" /></label>
                <label class="stat"><span>Ловкость</span><InputNumber @bind-Value="Character.Stats.Dexterity" @bind-Value:after="RecalculateModifiers" class="input" /></label>
                <label class="stat"><span>Телосложение</span><InputNumber @bind-Value="Character.Stats.Constitution" @bind-Value:after="RecalculateModifiers" class="input" /></label>
                <label class="stat"><span>Интеллект</span><InputNumber @bind-Value="Character.Stats.Intelligence" @bind-Value:after="RecalculateModifiers" class="input" /></label>
                <label class="stat"><span>Мудрость</span><InputNumber @bind-Value="Character.Stats.Wisdom" @bind-Value:after="RecalculateModifiers" class="input" /></label>
                <label class="stat"><span>Харизма</span><InputNumber @bind-Value="Character.Stats.Charisma" @bind-Value:after="RecalculateModifiers" class="input" /></label>
            </div>
        </section>

        <section class="form-section">
            <h2>Боевые параметры</h2>
            <div class="stats-grid combat-grid">
                <label class="stat"><span>Макс. HP</span><InputNumber @bind-Value="Character.Combat.MaxHealth" class="input" /></label>
                <label class="stat"><span>Класс брони</span><InputNumber @bind-Value="Character.Combat.ArmorClass" class="input" /></label>
                <label class="stat"><span>Защита</span><InputNumber @bind-Value="Character.Combat.Protection" class="input" /></label>
            </div>
            <div class="two-columns">
                <div class="equipment-field">
                    <label>Оружие<InputText @bind-Value="Character.Combat.Weapon" class="input" placeholder="Длинный меч" /></label>
                    <EquipmentPhotoPicker @bind-Value="Character.Combat.WeaponImageBase64" Title="Фото оружия (необязательно)" />
                </div>
                <div class="equipment-field">
                    <label>Броня<InputText @bind-Value="Character.Combat.Armor" class="input" placeholder="Кольчуга" /></label>
                    <EquipmentPhotoPicker @bind-Value="Character.Combat.ArmorImageBase64" Title="Фото брони (необязательно)" />
                </div>
            </div>
        </section>

        <CollapsibleSection Title="Навыки" Description="Можно оставить пустыми и добавить позже." Count="Character.Skills.Count" OnAdd="AddSkill">
            @foreach (var skill in Character.Skills)
            {
                <div class="skill-card" @key="skill">
                    <button type="button" class="remove-button card-remove" aria-label="Удалить навык" @onclick="() => RemoveSkill(skill)">×</button>
                    <InputText @bind-Value="skill.Name" class="input" placeholder="Название навыка" />
                    <InputTextArea @bind-Value="skill.Description" class="input description-input" placeholder="Описание" rows="3" />
                </div>
            }
        </CollapsibleSection>

        <CollapsibleSection Title="Инвентарь" Description="Предметы, с которыми персонаж начинает игру." Count="Character.Inventory.Count" OnAdd="AddItem">
            @foreach (var item in Character.Inventory)
            {
                <div class="item-card" @key="item">
                    <button type="button" class="remove-button card-remove" aria-label="Удалить предмет" @onclick="() => RemoveItem(item)">×</button>
                    <div class="item-card-fields">
                        <InputText @bind-Value="item.Name" class="input" placeholder="Название предмета" />
                        <div class="quantity-field"><span class="quantity-label">Количество</span><InputNumber @bind-Value="item.Quantity" class="input quantity-input" /></div>
                        <InputTextArea @bind-Value="item.Description" class="input description-input" placeholder="Описание" rows="3" />
                    </div>
                </div>
            }
        </CollapsibleSection>
    </EditForm>
</div>

@code {
    private Character Character { get; } = new();
    private string? AvatarError;
    private string? SaveError;

    protected override void OnInitialized() => Character.Stats.RecalculateModifiers();

    private async Task PickAvatar()
    {
        AvatarError = null;
        try
        {
            var photoPermission = await Permissions.CheckStatusAsync<Permissions.Photos>();
            if (photoPermission != PermissionStatus.Granted)
                photoPermission = await Permissions.RequestAsync<Permissions.Photos>();
            if (photoPermission != PermissionStatus.Granted) { AvatarError = "Нет разрешения на доступ к фотографиям."; return; }
            var photo = await MediaPicker.Default.PickPhotoAsync(new MediaPickerOptions { Title = "Выберите аватар персонажа" });
            if (photo is null) return;
            await using var stream = await photo.OpenReadAsync();

            Character.ImageBase64 =
                await ImageCompressionService.CompressAsync(stream);
        }
        catch (Exception ex) { AvatarError = $"Не удалось выбрать изображение: {ex.Message}"; }
    }

    private void RecalculateModifiers() => Character.Stats.RecalculateModifiers();

    // New entries go to the top of the list so they appear right under the "Add" button.
    private void AddSkill() => Character.Skills.Insert(0, new CharacterSkill());
    private void RemoveSkill(CharacterSkill skill) => Character.Skills.Remove(skill);
    private void AddItem() => Character.Inventory.Insert(0, new CharacterItem());
    private void RemoveItem(CharacterItem item) => Character.Inventory.Remove(item);

    private async Task CreateCharacter()
    {
        if (string.IsNullOrWhiteSpace(Character.Name)) Character.Name = "Безымянный персонаж";
        if (Character.Combat.MaxHealth < 0) Character.Combat.MaxHealth = 0;
        Character.Combat.CurrentHealth = Character.Combat.MaxHealth;
        SaveError = null;

        try
        {
            var path = await CharacterStorage.SaveAsync(Character);
            Navigation.NavigateTo($"/characters/{Uri.EscapeDataString(Path.GetFileName(path))}");
        }
        catch (CharacterStorageService.CharacterAlreadyExistsException ex)
        {
            SaveError = ex.Message;
        }
    }
}
