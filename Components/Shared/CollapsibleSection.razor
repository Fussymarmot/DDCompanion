@* Collapsible section with a title, an "Add" button and a body.
   Starts collapsed only when it already has items; expands automatically after "Add". *@

<section class="@SectionClass collapsible-section @(expanded ? "is-open" : "is-closed")">
    <div class="collapsible-header">
        <h2 class="collapsible-title">
            <button type="button" class="collapsible-toggle" aria-expanded="@(expanded ? "true" : "false")" @onclick="Toggle">
                <svg class="collapsible-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" aria-hidden="true">
                    <path fill="currentColor" d="M297.4 438.6C309.9 451.1 330.2 451.1 342.7 438.6L502.7 278.6C515.2 266.1 515.2 245.8 502.7 233.3C490.2 220.8 469.9 220.8 457.4 233.3L320 370.7L182.6 233.4C170.1 220.9 149.8 220.9 137.3 233.4C124.8 245.9 124.8 266.2 137.3 278.7L297.3 438.7z"/>
                </svg>
                <span class="collapsible-title-text">@Title</span>
                @if (Count > 0)
                {
                    <span class="collapsible-count">@Count</span>
                }
            </button>
        </h2>
        <button type="button" class="small-button collapsible-add" @onclick="AddAsync">@AddLabel</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="collapsible-description">@Description</p>
    }

    <div class="collapsible-body" aria-hidden="@(expanded ? "false" : "true")">
        <div class="collapsible-inner">
            @ChildContent
        </div>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string AddLabel { get; set; } = "Добавить";
    [Parameter] public string SectionClass { get; set; } = "form-section";

    // Number of items inside; decides the initial state and shows the badge.
    [Parameter] public int Count { get; set; }

    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool expanded = true;
    private bool initialized;

    protected override void OnParametersSet()
    {
        if (initialized) return;
        initialized = true;

        // Collapsed from the start only when there is something to hide.
        expanded = Count == 0;
    }

    private void Toggle() => expanded = !expanded;

    private async Task AddAsync()
    {
        // The new entry is inserted at the top of the list, so make sure it is visible.
        expanded = true;
        await OnAdd.InvokeAsync();
    }
}
