@* Top navigation header with contextual actions (back, settings, create/import, save). *@
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DDCompanion.Services.CharacterStorageService CharacterStorage
@inject DDCompanion.Services.CharacterFolderService FolderService
@inject DDCompanion.Services.ThemeService ThemeService
@using Microsoft.Maui.ApplicationModel.DataTransfer
@implements IDisposable

<header class="nav-header">
    @if (IsSettingsPage || IsImportPage || IsCharacterPage || IsCharacterEditPage)
    {
        <button class="header-button back-button" type="button" aria-label="Назад" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <path fill="currentColor" d="M201.4 297.4C188.9 309.9 188.9 330.2 201.4 342.7L361.4 502.7C373.9 515.2 394.2 515.2 406.7 502.7C419.2 490.2 419.2 469.9 406.7 457.4L269.3 320L406.6 182.6C419.1 170.1 419.1 149.8 406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3L201.3 297.3z"/>
            </svg>
        </button>
    }
    else
    {
        <button class="header-button" type="button" @onclick="OpenSettings" aria-label="Настройки">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <path fill="currentColor" d="M259.1 73.5C262.1 58.7 275.2 48 290.4 48L350.2 48C365.4 48 378.5 58.7 381.5 73.5L396 143.5C410.1 149.5 423.3 157.2 435.3 166.3L503.1 143.8C517.5 139 533.3 145 540.9 158.2L570.8 210C578.4 223.2 575.7 239.8 564.3 249.9L511 297.3C511.9 304.7 512.3 312.3 512.3 320C512.3 327.7 511.8 335.3 511 342.7L564.4 390.2C575.8 400.3 578.4 417 570.9 430.1L541 481.9C533.4 495 517.6 501.1 503.2 496.3L435.4 473.8C423.3 482.9 410.1 490.5 396.1 496.6L381.7 566.5C378.6 581.4 365.5 592 350.4 592L290.6 592C275.4 592 262.3 581.3 259.3 566.5L244.9 496.6C230.8 490.6 217.7 482.9 205.6 473.8L137.5 496.3C123.1 501.1 107.3 495.1 99.7 481.9L69.8 430.1C62.2 416.9 64.9 400.3 76.3 390.2L129.7 342.7C128.8 335.3 128.4 327.7 128.4 320C128.4 312.3 128.9 304.7 129.7 297.3L76.3 249.8C64.9 239.7 62.3 223 69.8 209.9L99.7 158.1C107.3 144.9 123.1 138.9 137.5 143.7L205.3 166.2C217.4 157.1 230.6 149.5 244.6 143.4L259.1 73.5zM320.3 400C364.5 399.8 400.2 363.9 400 319.7C399.8 275.5 363.9 239.8 319.7 240C275.5 240.2 239.8 276.1 240 320.3C240.2 364.5 276.1 400.2 320.3 400z"/>
            </svg>
        </button>
    }

    @if (!IsSettingsPage)
    {
        <button class="app-title" type="button" @onclick="GoHome">
            <span>Dungeons &amp;</span>
            <span>Dragons</span>
        </button>
    }
    else
    {
        <span class="page-title">Настройки</span>
    }

    @if (IsSettingsPage)
    {
        <button class="header-button theme-toggle-button @(ThemeService.IsLightTheme ? "is-light" : "is-dark")" type="button"
                aria-label="@(ThemeService.IsLightTheme ? "Включить тёмную тему" : "Включить белую тему")"
                title="@(ThemeService.IsLightTheme ? "Тёмная тема" : "Белая тема")"
                @onclick="ToggleTheme">
            <span class="theme-icon theme-icon-sun" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path fill="currentColor" d="M320 32C328.4 32 336.3 36.4 340.6 43.7L396.1 136.3L500.9 110C509.1 108 517.8 110.4 523.7 116.3C529.6 122.2 532 131 530 139.1L503.7 243.8L596.4 299.3C603.6 303.6 608.1 311.5 608.1 319.9C608.1 328.3 603.7 336.2 596.4 340.5L503.7 396.1L530 500.8C532 509 529.6 517.7 523.7 523.6C517.8 529.5 509 532 500.9 530L396.2 503.7L340.7 596.4C336.4 603.6 328.5 608.1 320.1 608.1C311.7 608.1 303.8 603.7 299.5 596.4L243.9 503.7L139.2 530C131 532 122.4 529.6 116.4 523.7C110.4 517.8 108 509 110 500.8L136.2 396.1L43.6 340.6C36.4 336.2 32 328.4 32 320C32 311.6 36.4 303.7 43.7 299.4L136.3 243.9L110 139.1C108 130.9 110.3 122.3 116.3 116.3C122.3 110.3 131 108 139.2 110L243.9 136.2L299.4 43.6L301.2 41C305.7 35.3 312.6 31.9 320 31.9zM320 176C240.5 176 176 240.5 176 320C176 399.5 240.5 464 320 464C399.5 464 464 399.5 464 320C464 240.5 399.5 176 320 176zM320 416C267 416 224 373 224 320C224 267 267 224 320 224C373 224 416 267 416 320C416 373 373 416 320 416z"/>
                </svg>
            </span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path fill="currentColor" d="M320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576C388.8 576 451.3 548.8 497.3 504.6C504.6 497.6 506.7 486.7 502.6 477.5C498.5 468.3 488.9 462.6 478.8 463.4C473.9 463.8 469 464 464 464C362.4 464 280 381.6 280 280C280 207.9 321.5 145.4 382.1 115.2C391.2 110.7 396.4 100.9 395.2 90.8C394 80.7 386.6 72.5 376.7 70.3C358.4 66.2 339.4 64 320 64z"/>
                </svg>
            </span>
        </button>
    }
    else if (IsHomePage)
    {
        <button class="header-button" type="button" aria-label="Создать или импортировать персонажа" @onclick="OpenCharacterActions">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <path fill="currentColor" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>
            </svg>
        </button>
    }
    else if (IsCharacterPage)
    {
        <button class="header-button more-button" type="button" aria-label="Дополнительные действия" @onclick="OpenCharacterActions">
            <span>⋮</span>
        </button>
    }
    else if (IsCharacterEditPage)
    {
        <button class="header-button" type="button" aria-label="Сохранить" @onclick="SaveCharacter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <path fill="currentColor" d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 237.3C544 220.3 537.3 204 525.3 192L448 114.7C436 102.7 419.7 96 402.7 96L160 96zM192 192C192 174.3 206.3 160 224 160L384 160C401.7 160 416 174.3 416 192L416 256C416 273.7 401.7 288 384 288L224 288C206.3 288 192 273.7 192 256L192 192zM320 352C355.3 352 384 380.7 384 416C384 451.3 355.3 480 320 480C284.7 480 256 451.3 256 416C256 380.7 284.7 352 320 352z"/>
            </svg>
        </button>
    }
    else
    {
        <span class="header-placeholder"></span>
    }
</header>

@if (showCharacterActions)
{
    <div class="character-actions-overlay" @onclick="CloseCharacterActions">
        <div class="character-actions @(IsCharacterPage ? "character-page-actions" : "")" @onclick:stopPropagation>
            @if (IsHomePage)
            {
                <button class="character-action" type="button" @onclick="CreateCharacter">Создать персонажа</button>
                <button class="character-action" type="button" @onclick="ImportCharacter">Импортировать персонажа</button>
            }
            else if (IsCharacterPage)
            {
                <button class="character-action" type="button" @onclick="EditCharacterFromMenu">Изменить</button>
                <button class="character-action" type="button" @onclick="ShareCharacter">Поделиться</button>
                <button class="character-action danger-action" type="button" @onclick="DeleteCharacter">Удалить</button>
            }
        </div>
    </div>
}

@code {
    private bool showCharacterActions;

    private bool IsHomePage => Navigation.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);
    private bool IsSettingsPage => Navigation.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);
    private bool IsImportPage => Navigation.Uri.Contains("/characters/import", StringComparison.OrdinalIgnoreCase);
    private bool IsCharacterEditPage => Navigation.Uri.Contains("/characters/create", StringComparison.OrdinalIgnoreCase) || Navigation.Uri.Contains("/characters/edit", StringComparison.OrdinalIgnoreCase);
    private bool IsCharacterPage => Navigation.Uri.Contains("/characters/", StringComparison.OrdinalIgnoreCase) && !IsCharacterEditPage && !IsImportPage;

    private string CurrentCharacterFileName
    {
        get
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var fileName = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
            return string.IsNullOrWhiteSpace(fileName) ? string.Empty : Uri.UnescapeDataString(fileName);
        }
    }

    private string EditCharacterUrl => string.IsNullOrWhiteSpace(CurrentCharacterFileName)
        ? "/"
        : $"/characters/edit/{Uri.EscapeDataString(CurrentCharacterFileName)}";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ThemeService.ThemeChanged += OnThemeChanged;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        showCharacterActions = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleTheme() => ThemeService.SetLightTheme(!ThemeService.IsLightTheme);

    private void OpenSettings() => Navigation.NavigateTo("/settings");
    private void GoHome() => Navigation.NavigateTo("/");
    private void GoBack() => Navigation.NavigateTo("/");

    private void OpenCharacterActions() => showCharacterActions = true;
    private void CloseCharacterActions() => showCharacterActions = false;

    private void CreateCharacter()
    {
        CloseCharacterActions();
        Navigation.NavigateTo("/characters/create");
    }

    private void ImportCharacter()
    {
        CloseCharacterActions();
        Navigation.NavigateTo("/characters/import");
    }

    private void EditCharacterFromMenu()
    {
        CloseCharacterActions();
        Navigation.NavigateTo(EditCharacterUrl);
    }

    private async Task ShareCharacter()
    {
        CloseCharacterActions();

        var fileName = CurrentCharacterFileName;
        if (string.IsNullOrWhiteSpace(fileName)) return;

        var path = CharacterStorage.GetCharacterPath(fileName);
        if (!File.Exists(path)) return;

        try
        {
            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Поделиться персонажем",
                File = new ShareFile(path)
            });
        }
        catch
        {
            // The user may have dismissed the native share sheet.
        }
    }

    private async Task DeleteCharacter()
    {
        CloseCharacterActions();

        var fileName = CurrentCharacterFileName;
        if (string.IsNullOrWhiteSpace(fileName)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Удалить этого персонажа? Файл персонажа будет удалён.");
        if (!confirmed) return;

        if (await CharacterStorage.DeleteAsync(fileName))
        {
            await FolderService.ForgetCharacterAsync(fileName);
            Navigation.NavigateTo("/");
        }
    }

    private async Task SaveCharacter() => await JS.InvokeVoidAsync("submitCharacterForm");
}
