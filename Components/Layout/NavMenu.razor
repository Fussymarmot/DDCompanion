@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<header class="nav-header">
    @if (IsSettingsPage || IsCharacterPage || IsCharacterEditPage)
    {
        <button
            class="header-button back-button"
            type="button" aria-label="Назад"
            @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path fill="rgb(255, 255, 255)" d="M201.4 297.4C188.9 309.9 188.9 330.2 201.4 342.7L361.4 502.7C373.9 515.2 394.2 515.2 406.7 502.7C419.2 490.2 419.2 469.9 406.7 457.4L269.3 320L406.6 182.6C419.1 170.1 419.1 149.8 406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3L201.3 297.3z"/>
            </svg>
        </button>
    }
    else
    {
        <button class="header-button" type="button" @onclick="OpenSettings" aria-label="Настройки">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path fill="rgb(255, 255, 255)" d="M259.1 73.5C262.1 58.7 275.2 48 290.4 48L350.2 48C365.4 48 378.5 58.7 381.5 73.5L396 143.5C410.1 149.5 423.3 157.2 435.3 166.3L503.1 143.8C517.5 139 533.3 145 540.9 158.2L570.8 210C578.4 223.2 575.7 239.8 564.3 249.9L511 297.3C511.9 304.7 512.3 312.3 512.3 320C512.3 327.7 511.8 335.3 511 342.7L564.4 390.2C575.8 400.3 578.4 417 570.9 430.1L541 481.9C533.4 495 517.6 501.1 503.2 496.3L435.4 473.8C423.3 482.9 410.1 490.5 396.1 496.6L381.7 566.5C378.6 581.4 365.5 592 350.4 592L290.6 592C275.4 592 262.3 581.3 259.3 566.5L244.9 496.6C230.8 490.6 217.7 482.9 205.6 473.8L137.5 496.3C123.1 501.1 107.3 495.1 99.7 481.9L69.8 430.1C62.2 416.9 64.9 400.3 76.3 390.2L129.7 342.7C128.8 335.3 128.4 327.7 128.4 320C128.4 312.3 128.9 304.7 129.7 297.3L76.3 249.8C64.9 239.7 62.3 223 69.8 209.9L99.7 158.1C107.3 144.9 123.1 138.9 137.5 143.7L205.3 166.2C217.4 157.1 230.6 149.5 244.6 143.4L259.1 73.5zM320.3 400C364.5 399.8 400.2 363.9 400 319.7C399.8 275.5 363.9 239.8 319.7 240C275.5 240.2 239.8 276.1 240 320.3C240.2 364.5 276.1 400.2 320.3 400z"/>
            </svg>
        </button>
    }

    @if (!IsSettingsPage)
    {
        <button class="app-title" type="button" @onclick="GoHome">
            <span>Dungeons &amp;</span> 
            <span>Dragons</span>
        </button>
    }
    else
    {
        <span class="page-title">Настройки</span>
    }

    @if (IsHomePage)
    {
        <button
            class="header-button"
            type="button"
            aria-label="Создать или импортировать персонажа"
            @onclick="OpenCharacterActions">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path fill="rgb(255, 255, 255)" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>
            </svg>
        </button>
    }
    else if (IsCharacterPage)
    {
        <div class="header-actions">
            <button
                class="header-button"
                type="button"
                @onclick="EditCharacter"
                aria-label="Редактировать персонажа">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="rgb(255, 255, 255)" d="M416.9 85.2L372 130.1L509.9 268L554.8 223.1C568.4 209.6 576 191.2 576 172C576 152.8 568.4 134.4 554.8 120.9L519.1 85.2C505.6 71.6 487.2 64 468 64C448.8 64 430.4 71.6 416.9 85.2zM338.1 164L122.9 379.1C112.2 389.8 104.4 403.2 100.3 417.8L64.9 545.6C62.6 553.9 64.9 562.9 71.1 569C77.3 575.1 86.2 577.5 94.5 575.2L222.3 539.7C236.9 535.6 250.2 527.9 261 517.1L476 301.9L338.1 164z"/>
                </svg>
            </button> 
        
            <button
                class="header-button"
                type="button"
                aria-label="Поделиться"
                @onclick="ShareCharacter">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="rgb(255, 255, 255)" d="M448 256C501 256 544 213 544 160C544 107 501 64 448 64C395 64 352 107 352 160C352 165.4 352.5 170.8 353.3 176L223.6 248.1C206.7 233.1 184.4 224 160 224C107 224 64 267 64 320C64 373 107 416 160 416C184.4 416 206.6 406.9 223.6 391.9L353.3 464C352.4 469.2 352 474.5 352 480C352 533 395 576 448 576C501 576 544 533 544 480C544 427 501 384 448 384C423.6 384 401.4 393.1 384.4 408.1L254.7 336C255.6 330.8 256 325.5 256 320C256 314.5 255.5 309.2 254.7 304L384.4 231.9C401.3 246.9 423.6 256 448 256z"/>
                </svg>
            </button>
        </div>
    }
    else if (IsCharacterEditPage)
    {
        <button
            class="header-button"
            type="button"
            aria-label="Сохранить"
            @onclick="SaveCharacter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path fill="rgb(255, 255, 255)" d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 237.3C544 220.3 537.3 204 525.3 192L448 114.7C436 102.7 419.7 96 402.7 96L160 96zM192 192C192 174.3 206.3 160 224 160L384 160C401.7 160 416 174.3 416 192L416 256C416 273.7 401.7 288 384 288L224 288C206.3 288 192 273.7 192 256L192 192zM320 352C355.3 352 384 380.7 384 416C384 451.3 355.3 480 320 480C284.7 480 256 451.3 256 416C256 380.7 284.7 352 320 352z"/>
            </svg>
        </button>
    }
    else
    {
        <span class="header-placeholder"></span>
    }
</header>

@if (showCharacterActions)
{
    <div
        class="character-actions-overlay"
        @onclick="CloseCharacterActions">
        
        <div
            class="character-actions"
            @onclick:stopPropagation>
            <button
                class="character-action"
                type="button"
                @onclick="CreateCharacter">
                
                <span>Создать персонажа</span>
            </button> 
            
            <button
                class="character-action"
                type="button"
                @onclick="ImportCharacter">
                
                <span>Импортировать персонажа</span>
            </button>
        </div>
    </div>
}

@code { 
    private bool showCharacterActions; 
    
    private bool IsHomePage => 
        Navigation.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase); 
    
    private bool IsSettingsPage => 
        Navigation.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase); 
    
    private bool IsCharacterEditPage => 
        Navigation.Uri.Contains("/characters/create", StringComparison.OrdinalIgnoreCase) || 
        Navigation.Uri.Contains("/characters/edit", StringComparison.OrdinalIgnoreCase); 
    
    private bool IsCharacterPage => 
        Navigation.Uri.Contains("/characters/", StringComparison.OrdinalIgnoreCase) && !IsCharacterEditPage; 
    
    private string EditCharacterUrl
    {
        get
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var fileName = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
            return string.IsNullOrWhiteSpace(fileName) ? "/" : $"/characters/edit/{Uri.EscapeDataString(Uri.UnescapeDataString(fileName))}";
        }
    } 
    
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
    private void OpenSettings() => Navigation.NavigateTo("/settings");
    private void GoHome() => Navigation.NavigateTo("/");
    private void EditCharacter() => Navigation.NavigateTo(EditCharacterUrl);
    private void GoBack() { Navigation.NavigateTo("/"); } 
    
    private void OpenCharacterActions() { showCharacterActions = true; } 
    
    private void CloseCharacterActions() { showCharacterActions = false; } 
    
    private void CreateCharacter() { showCharacterActions = false; Navigation.NavigateTo("/characters/create"); } 
    
    private void ImportCharacter() { showCharacterActions = false; Navigation.NavigateTo("/characters/import"); } 
    
    private async Task ShareCharacter() {  /*Здесь позже можно подключить JS navigator.share. */} 
    
    private async Task SaveCharacter() { await JS.InvokeVoidAsync("submitCharacterForm"); } 
}