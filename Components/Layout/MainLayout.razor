@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app">
    <NavMenu />

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("blazorReady");
        }
    }
}